{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Warsaw",
  "schedule": ["* 4 * * 1,4,6"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "rebaseWhen": "conflicted",
  "separateMajorMinor": false,
  "assignees": ["kamkry-zz"],
  "enabledManagers": [
    "npm",
    "pep621",
    "dockerfile",
    "helmv3",
    "helm-values"
  ],
  "bumpVersions": [
    {
      "name": "Bump Helm image tag",
      "filePatterns": ["helm/curriculum-v/values.yaml"],
      "matchStrings": ["imageTag:\\s*[\"']?(?<version>\\d+\\.\\d+\\.\\d+)"],
      "bumpType": "patch"
    }
  ],
  "packageRules": [
    {
      "description": "One PR for all dependency updates, majors combined with minors (supersedes the old per-ecosystem non-major groups)",
      "matchPackageNames": ["*"],
      "groupName": "dependencies",
      "groupSlug": "all"
    }
  ]
}
