{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "npm",
    "pep621",
    "dockerfile",
    "helmv3",
    "helm-values"
  ],
  "bumpVersions": [
    {
      "name": "Bump Helm image tag",
      "filePatterns": ["helm/curriculum-v/values.yaml"],
      "matchStrings": ["imageTag:\\s*[\"']?(?<version>\\d+\\.\\d+\\.\\d+)"],
      "bumpType": "patch"
    }
  ],
  "packageRules": [
    {
      "description": "Group npm non-major updates together",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major dependencies"
    },
    {
      "description": "Group Python non-major updates together",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Python non-major dependencies"
    }
  ]
}
